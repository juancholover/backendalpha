# ===========================================
# Variables de Entorno para Backend Alpha
# ===========================================
# Copiar este archivo a .env y configurar los valores reales
# NO subir .env al repositorio

# ===========================================
# BASE DE DATOS
# ===========================================
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://localhost:5432/academicobd
QUARKUS_DATASOURCE_USERNAME=postgres
QUARKUS_DATASOURCE_PASSWORD=TuContraseñaPostgres

# ===========================================
# JWT / AUTENTICACIÓN
# ===========================================
JWT_SECRET=TuClaveSecretaJWT_MinimoMuy32Caracteres

# ===========================================
# SUPERADMIN (Usuario inicial del sistema)
# ===========================================
# Cambiar estos valores en producción!
APP_SUPERADMIN_EMAIL=superadmin@tudominio.edu.pe
APP_SUPERADMIN_PASSWORD=CambiarEnProduccion123!
APP_SUPERADMIN_ENABLED=true

# ===========================================
# AZURE BLOB STORAGE
# ===========================================
# Obtener desde Azure Portal > Storage Account > Access Keys
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=TuCuenta;AccountKey=TuAccountKey;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=institution-images
